{
  "name": "solax-mcp",
  "version": "0.0.1",
  "private": true,
  "description": "MCP server exposing photovoltaic (PV) data for AI agents",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "debug:cloud": "tsx scripts/debug-solax-cloud.ts",
    "debug:modbus": "tsx scripts/debug-solax-modbus.ts",
    "dev": "tsx watch src/index.ts",
    "ingest:bigquery": "tsx scripts/ingest-bigquery-sample.ts",
    "migrate:bigquery": "tsx scripts/migrate-bigquery.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "modbus-serial": "^8.0.25",
    "zod": "^4.3.6"
  }
}
